# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Tencent Cloud OCR Configuration
# 腾讯云OCR服务配置
# 获取方式：登录腾讯云控制台 -> 访问管理 -> API密钥管理
# https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key

# 腾讯云地域配置（可选，默认为ap-beijing）
# 支持的地域：ap-beijing, ap-shanghai, ap-guangzhou, ap-chengdu, ap-chongqing, ap-nanjing, ap-tianjin, ap-shenzhen, ap-hongkong, ap-singapore, ap-mumbai, ap-seoul, ap-bangkok, ap-tokyo, na-siliconvalley, na-ashburn, eu-frankfurt
TENCENT_REGION=ap-beijing

# Google Analytics Configuration
# 获取方式：登录 Google Analytics -> 管理 -> 数据流 -> 选择网站数据流 -> 查看测量ID
# 格式：G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id

# Microsoft Clarity Configuration
# 获取方式：登录 Microsoft Clarity -> 设置 -> 项目详情 -> 项目ID
# 格式：项目ID字符串（例如：unvs63hqfx）
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id

# Alibaba Cloud VL API Configuration
# 阿里云通义千问视觉模型 API 配置
# 获取方式：登录阿里云控制台 -> DashScope -> API-KEY管理
# https://dashscope.console.aliyun.com/apiKey
# 支持多个 Key（用逗号分隔），系统会自动轮询使用并在失败时切换
# 格式：sk-xxxxxx,sk-yyyyyy,sk-zzzzzz
ALI_VL_API_KEYS=your_ali_vl_api_key_1,your_ali_vl_api_key_2,your_ali_vl_api_key_3

# 兼容旧配置：单个 Key（如果设置了 ALI_VL_API_KEYS 则优先使用 ALI_VL_API_KEYS）
# ALI_VL_API_KEY=your_ali_vl_api_key

# Baidu OCR Configuration
# 百度智能云 文字识别（通用文字识别标准版）配置
# 获取方式：登录百度智能云控制台 -> 文字识别 -> 应用列表 -> 创建应用，获取 API Key 和 Secret Key
# https://console.bce.baidu.com/ai/#/ai/ocr/app/list
# 文档：https://cloud.baidu.com/doc/OCR/s/zk3h7xz52
# 配置后，/api/ocr/auto 端点会在阿里云 VL 与百度 OCR 之间随机选择
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key

# Next.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000